# Salin file ini menjadi .env.local HANYA untuk uji coba di komputer sendiri.
# Untuk Vercel, isi nilai ini di Project Settings > Environment Variables, BUKAN di file.

# Pilih salah satu penyedia AI (cukup isi satu):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Opsional
# AI_PROVIDER=gemini
# ALLOWED_ORIGIN=https://nama-proyekmu.vercel.app
# RATE_LIMIT=30
